erDiagram
    users {
        ObjectId _id PK
        string name
        string email UK
        string hashed_password
        list_string role
        string otp
        datetime otp_expiry
    }

    chats {
        ObjectId _id PK
        string user_id FK
        string title
        int message_count
        string created_at
        string updated_at
    }

    chat_messages {
        ObjectId _id PK
        string chat_id FK
        string user
        string assistant
        int input_tokens
        int output_tokens
        float response_time
        string created_at
        int seq
    }

    users ||--o{ chats : "owns (user_id)"
    chats ||--o{ chat_messages : "contains (chat_id)"
